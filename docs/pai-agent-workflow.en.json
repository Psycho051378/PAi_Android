  "cards": [
    {
      "dot": "cyan",
      "title": "Decision",
      "items": [
        "DecisionEngine picks: skill / plan / ReAct",
        "AiRepository handles context window and provider",
        "Query planner (AgentPlanner) builds the step plan and calls the LLM itself",
        "Plans with more than 2 steps are delegated to the ReAct loop"
      ]
    },
    {
      "dot": "emerald",
      "title": "Execution",
      "items": [
        "TaskQueue runs the project step by step",
        "CodeGenerator writes files and runs Python"
      ]
    },
    {
      "dot": "rose",
      "title": "Control",
      "items": [
        "Generated code is verified before running",
        "Paths never leave the workspace"
      ]
    }
  ]
